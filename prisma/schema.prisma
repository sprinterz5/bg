generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum BookSource {
  GOOGLE_BOOKS
  OPEN_LIBRARY
  MANUAL
}

enum ShelfStatus {
  READING
  READ
  WANT_TO_READ
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}

enum ReviewStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}

enum ModerationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum StoryStatus {
  ACTIVE
  EXPIRED
  DELETED
}

enum LikeTargetType {
  ARTICLE
  REVIEW
  STORY
  NOTE
  COMMENT
}

enum CommentTargetType {
  ARTICLE
  REVIEW
}

enum BookmarkTargetType {
  ARTICLE
  REVIEW
  BOOK
  NOTE
}

enum ContentScoreTargetType {
  ARTICLE
  REVIEW
}

enum ContentCounterTargetType {
  ARTICLE
  REVIEW
  STORY
  NOTE
  COMMENT
  BOOK
}

enum NoteTargetType {
  ARTICLE
  REVIEW
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  SHARE_BOOK
  SHARE_ARTICLE
  SHARE_REVIEW
  SYSTEM
}

enum ModerationTargetType {
  ARTICLE
  REVIEW
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  REMOVED
}

enum ExploreTargetType {
  ARTICLE
  REVIEW
}

enum MediaKind {
  AVATAR
  ARTICLE_COVER
  STORY_IMAGE
  CHAT_ATTACHMENT
  BOOK_COVER_CACHE
}

enum ReportTargetType {
  USER
  ARTICLE
  REVIEW
  STORY
  MESSAGE
  NOTE
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  COPYRIGHT
  AI_SLOP
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportResolution {
  CONTENT_REMOVED
  USER_WARNED
  USER_SUSPENDED
  NO_VIOLATION
  DUPLICATE
  OTHER
}

enum FeedEventType {
  IMPRESSION
  OPEN
  READ_PROGRESS
  DWELL_TIME
  LIKE
  SAVE
  HIDE
  SHARE
  BOOKMARK
  COMMENT
}

enum FeedEventTargetType {
  ARTICLE
  REVIEW
  BOOK
  STORY
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  COMMENT_REPLY
  NOTE_REPLY
  MESSAGE
  STORY_VIEW
  MODERATION_APPROVED
  MODERATION_REJECTED
  REPORT_RESOLVED
  BOOKMARK
  SYSTEM
}

enum NotificationActorType {
  USER
  SYSTEM
}

enum NotificationTargetType {
  USER
  ARTICLE
  REVIEW
  BOOK
  STORY
  MESSAGE
  REPORT
  CONVERSATION
  COMMENT
  SYSTEM
}

enum MediaStorageProvider {
  LOCAL
  R2
  S3
}

enum MediaVariantKind {
  THUMBNAIL
  PREVIEW
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum MediaModerationProvider {
  DISABLED
  LOCAL_STUB
  OPENAI
  GOOGLE_VISION
  AWS_REKOGNITION
  HIVE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  username     String    @unique
  displayName  String?
  bio          String?   @db.Text
  avatarUrl    String?
  passwordHash String?
  appleUserId  String?   @unique
  role         UserRole  @default(USER)
  interests    String[]  @default([])
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  emailVerified      Boolean   @default(false)
  emailVerifyToken   String?
  emailVerifyExpires DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  authoredArticles Article[]
  authoredReviews  Review[]
  shelfItems       ShelfItem[]
  notes            Note[]
  stories          Story[]
  storyViews       StoryView[]
  likes            Like[]
  refreshTokens    RefreshToken[]
  mediaAssets      MediaAsset[]
  reportsFiled     Report[]       @relation("ReportsFiled")
  reportsModerated Report[]       @relation("ReportsModerated")
  mediaModerations MediaModerationEvent[] @relation("MediaModerators")
  feedEvents       FeedEvent[]
  notifications    Notification[] @relation("UserNotifications")
  notificationActs Notification[] @relation("NotificationActors")

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  conversationMemberships ConversationMember[]
  sentMessages            Message[]
  moderationActions       ModerationEvent[]    @relation("ModeratorActions")

  comments       Comment[]
  bookmarks      Bookmark[]
  blocksGiven    UserBlock[] @relation("BlocksGiven")
  blocksReceived UserBlock[] @relation("BlocksReceived")
  mutesGiven     UserMute[]  @relation("MutesGiven")
  mutesReceived  UserMute[]  @relation("MutesReceived")
  deviceTokens   DeviceToken[]

  @@index([username])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Book {
  id             String     @id @default(uuid()) @db.Uuid
  googleBooksId  String?    @unique
  openLibraryKey String?    @unique
  isbn10         String?
  isbn13         String?    @unique
  title          String
  subtitle       String?
  authors        String[]   @default([])
  description    String?    @db.Text
  thumbnailUrl   String?
  language       String?
  publishedDate  String?
  publisher      String?
  pageCount      Int?
  categories     String[]   @default([])
  source         BookSource @default(MANUAL)
  rawJson        Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  shelfItems  ShelfItem[]
  reviews     Review[]
  stories     Story[]
  messages    Message[]
  similarFrom BookSimilarity[] @relation("SimilarFrom")
  similarTo   BookSimilarity[] @relation("SimilarTo")

  @@index([title])
  @@index([isbn10])
  @@index([isbn13])
  @@index([createdAt])
  @@index([authors], type: Gin)
  @@index([categories], type: Gin)
}

model ShelfItem {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  bookId          String      @db.Uuid
  status          ShelfStatus
  rating          Int?
  progressPage    Int?
  progressPercent Int?
  privateNote     String?     @db.Text
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([bookId])
}

model Article {
  id                 String           @id @default(uuid()) @db.Uuid
  authorId           String           @db.Uuid
  title              String
  slug               String           @unique
  subtitle           String?
  excerpt            String?          @db.Text
  body               String           @db.Text
  coverImageUrl      String?
  tags               String[]         @default([])
  status             ArticleStatus    @default(DRAFT)
  moderationStatus   ModerationStatus @default(PENDING)
  moderationReason   String?          @db.Text
  readingTimeMinutes Int              @default(1)
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notes  Note[]

  @@index([authorId, createdAt])
  @@index([status, moderationStatus, publishedAt])
  @@index([status, moderationStatus, deletedAt, publishedAt])
  @@index([publishedAt])
  @@index([tags], type: Gin)
}

model Review {
  id                 String           @id @default(uuid()) @db.Uuid
  authorId           String           @db.Uuid
  bookId             String           @db.Uuid
  title              String
  body               String           @db.Text
  rating             Int?
  tags               String[]         @default([])
  status             ReviewStatus     @default(DRAFT)
  moderationStatus   ModerationStatus @default(PENDING)
  moderationReason   String?          @db.Text
  readingTimeMinutes Int              @default(1)
  publishedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  notes  Note[]

  @@index([authorId, createdAt])
  @@index([bookId])
  @@index([status, moderationStatus, publishedAt])
  @@index([status, moderationStatus, deletedAt, publishedAt])
  @@index([publishedAt])
  @@index([tags], type: Gin)
}

model Note {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  targetType   NoteTargetType
  articleId    String?        @db.Uuid
  reviewId     String?        @db.Uuid
  selectedText String         @db.Text
  noteText     String         @db.Text
  anchorStart  Int?
  anchorEnd    Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  review  Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([articleId])
  @@index([reviewId])
}

model Story {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  bookId        String?     @db.Uuid
  mediaUrl      String
  mediaMimeType String
  caption       String?
  status        StoryStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book?       @relation(fields: [bookId], references: [id], onDelete: SetNull)
  views StoryView[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model StoryView {
  id       String   @id @default(uuid()) @db.Uuid
  storyId  String   @db.Uuid
  viewerId String   @db.Uuid
  viewedAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

model Like {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  targetType LikeTargetType
  targetId   String         @db.Uuid
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType @default(DIRECT)
  title     String?
  directKey String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  mutedUntil     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  conversationId  String      @db.Uuid
  senderId        String      @db.Uuid
  type            MessageType @default(TEXT)
  body            String?     @db.Text
  sharedBookId    String?     @db.Uuid
  sharedArticleId String?     @db.Uuid
  sharedReviewId  String?     @db.Uuid
  createdAt       DateTime    @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sharedBook   Book?        @relation(fields: [sharedBookId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ModerationEvent {
  id          String               @id @default(uuid()) @db.Uuid
  targetType  ModerationTargetType
  targetId    String               @db.Uuid
  action      ModerationAction
  reason      String?              @db.Text
  moderatorId String?              @db.Uuid
  createdAt   DateTime             @default(now())

  moderator User? @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}

model ExploreItem {
  id               String            @id @default(uuid()) @db.Uuid
  targetType       ExploreTargetType
  targetId         String            @db.Uuid
  score            Float             @default(0)
  moderationStatus ModerationStatus  @default(PENDING)
  reason           String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([targetType, targetId])
  @@index([moderationStatus, score])
}

model MediaAsset {
  id         String               @id @default(uuid()) @db.Uuid
  ownerId    String?              @db.Uuid
  kind       MediaKind
  provider   MediaStorageProvider @default(LOCAL)
  bucket     String?
  url        String
  storageKey String
  mimeType   String
  byteSize   Int
  width      Int?
  height     Int?
  checksum   String?
  moderationStatus MediaModerationStatus @default(PENDING)
  moderationProvider MediaModerationProvider @default(DISABLED)
  moderationScore Float?
  moderationReason String? @db.Text
  moderatedAt DateTime?
  createdAt  DateTime             @default(now())

  owner    User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  variants MediaVariant[]
  moderationEvents MediaModerationEvent[]

  @@index([ownerId, createdAt])
  @@index([kind, createdAt])
  @@index([provider, storageKey])
  @@index([moderationStatus, createdAt])
}

model MediaVariant {
  id           String               @id @default(uuid()) @db.Uuid
  mediaAssetId String               @db.Uuid
  kind         MediaVariantKind
  provider     MediaStorageProvider @default(LOCAL)
  bucket       String?
  url          String
  storageKey   String
  mimeType     String
  byteSize     Int
  width        Int?
  height       Int?
  createdAt    DateTime             @default(now())

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, kind])
  @@index([provider, storageKey])
}

model Report {
  id            String            @id @default(uuid()) @db.Uuid
  reporterId    String            @db.Uuid
  targetType    ReportTargetType
  targetId      String            @db.Uuid
  reason        ReportReason
  details       String?           @db.Text
  status        ReportStatus      @default(OPEN)
  resolution    ReportResolution?
  moderatorId   String?           @db.Uuid
  moderatorNote String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  resolvedAt    DateTime?

  reporter  User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User? @relation("ReportsModerated", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([moderatorId])
}

model MediaModerationEvent {
  id        String                  @id @default(uuid()) @db.Uuid
  mediaId   String                  @db.Uuid
  provider  MediaModerationProvider
  status    MediaModerationStatus
  score     Float?
  reason    String?                 @db.Text
  rawJson   Json?
  moderatorId String?               @db.Uuid
  createdAt DateTime                @default(now())

  media     MediaAsset              @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  moderator User?                   @relation("MediaModerators", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([mediaId, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
}

model FeedEvent {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  eventType  FeedEventType
  targetType FeedEventTargetType
  targetId   String              @db.Uuid
  source     String?
  dwellMs    Int?
  progress   Int?
  metadata   Json?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([eventType, createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  type       NotificationType
  actorType  NotificationActorType  @default(SYSTEM)
  actorId    String?                @db.Uuid
  targetType NotificationTargetType
  targetId   String?
  title      String
  body       String?                @db.Text
  data       Json?
  readAt     DateTime?
  createdAt  DateTime               @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
}

// ─── Comments ────────────────────────────────────────

model Comment {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  targetType CommentTargetType
  targetId   String            @db.Uuid
  parentId   String?           @db.Uuid
  body       String            @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentReplies")

  @@index([targetType, targetId, createdAt])
  @@index([parentId])
  @@index([userId, createdAt])
}

// ─── Bookmarks / Saves ──────────────────────────────

model Bookmark {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  targetType BookmarkTargetType
  targetId   String             @db.Uuid
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
}

// ─── Block / Mute ───────────────────────────────────

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserMute {
  id        String   @id @default(uuid()) @db.Uuid
  muterId   String   @db.Uuid
  mutedId   String   @db.Uuid
  createdAt DateTime @default(now())

  muter User @relation("MutesGiven", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([mutedId])
}

// ─── Content Scoring ────────────────────────────────

model ContentScore {
  id              String                @id @default(uuid()) @db.Uuid
  targetType      ContentScoreTargetType
  targetId        String                @db.Uuid
  qualityScore    Float                 @default(0)
  engagementScore Float                 @default(0)
  trendingScore   Float                 @default(0)
  spamScore       Float                 @default(0)
  impressions     Int                   @default(0)
  opens           Int                   @default(0)
  completions     Int                   @default(0)
  totalDwellMs    BigInt                @default(0)
  likes           Int                   @default(0)
  saves           Int                   @default(0)
  hides           Int                   @default(0)
  shares          Int                   @default(0)
  comments        Int                   @default(0)
  reports         Int                   @default(0)
  updatedAt       DateTime              @updatedAt
  createdAt       DateTime              @default(now())

  @@unique([targetType, targetId])
  @@index([qualityScore])
  @@index([trendingScore])
}

// ─── Book Similarity Graph ──────────────────────────

model BookSimilarity {
  id        String   @id @default(uuid()) @db.Uuid
  bookAId   String   @db.Uuid
  bookBId   String   @db.Uuid
  score     Float
  reasons   String[] @default([])
  updatedAt DateTime @updatedAt

  bookA Book @relation("SimilarFrom", fields: [bookAId], references: [id], onDelete: Cascade)
  bookB Book @relation("SimilarTo", fields: [bookBId], references: [id], onDelete: Cascade)

  @@unique([bookAId, bookBId])
  @@index([bookAId, score(sort: Desc)])
  @@index([bookBId, score(sort: Desc)])
}

// ─── Device Tokens (Push) ───────────────────────────

enum Platform {
  IOS
  ANDROID
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiEmbeddingTargetType {
  ARTICLE
  REVIEW
  BOOK
}

enum AiEmbeddingStatus {
  PENDING
  READY
  FAILED
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?
  responseBody Json?
  createdAt    DateTime          @default(now())
  expiresAt    DateTime

  @@unique([userId, key])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

model ContentCounter {
  id          String                   @id @default(uuid()) @db.Uuid
  targetType  ContentCounterTargetType
  targetId    String                   @db.Uuid
  likes       Int                      @default(0)
  comments    Int                      @default(0)
  bookmarks   Int                      @default(0)
  shares      Int                      @default(0)
  reports     Int                      @default(0)
  views       Int                      @default(0)
  updatedAt   DateTime                 @updatedAt
  createdAt   DateTime                 @default(now())

  @@unique([targetType, targetId])
  @@index([targetType, targetId])
}

model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  status     JobRunStatus @default(RUNNING)
  payload    Json?
  result     Json?
  error      String?      @db.Text
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([name, startedAt])
  @@index([status, startedAt])
}

model AiEmbedding {
  id          String                @id @default(uuid()) @db.Uuid
  targetType  AiEmbeddingTargetType
  targetId    String                @db.Uuid
  provider    String
  model       String
  dimensions  Int
  inputHash   String
  vector      Json?
  textPreview String?               @db.Text
  status      AiEmbeddingStatus     @default(PENDING)
  error       String?               @db.Text
  embeddedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([targetType, targetId, model])
  @@index([targetType, targetId])
  @@index([model, status, updatedAt])
}
