NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_BASE_URL=http://localhost:4000

DATABASE_URL=postgresql://puzzle:puzzle@localhost:5432/puzzle?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

APPLE_CLIENT_ID=com.example.bookgram
# Comma-separated Google OAuth client ids (web, iOS, Android) whose ID tokens are accepted
GOOGLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Email delivery. LOG = dev transport (no real send; tokens are surfaced via the
# API in non-production only). RESEND = deliver via the Resend HTTP API.
# In production you MUST set EMAIL_PROVIDER=RESEND + RESEND_API_KEY, otherwise
# verification/reset emails are not sent (tokens are never logged in production).
EMAIL_PROVIDER=LOG
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
EMAIL_FROM=no-reply@bookgram.dev
EMAIL_VERIFY_URL=http://localhost:4000/auth/email/verify
PASSWORD_RESET_URL=http://localhost:4000/auth/password/reset

PUSH_DELIVERY_MODE=LOG
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=

JOB_RUNNER_ENABLED=false
JOB_RUN_ON_STARTUP=false
JOB_SPAM_SCORE_INTERVAL_MINUTES=60
JOB_SPAM_SCORE_LIMIT=200
JOB_SPAM_SCORE_THRESHOLD=70
JOB_MAINTENANCE_INTERVAL_MINUTES=30
JOB_BOOK_SIMILARITY_LIMIT=50

AI_ENABLED=false
AI_PROVIDER=DISABLED
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_EMBEDDING_MODEL=bookgram-local-hash-embedding-v1
AI_EMBEDDING_DIMENSIONS=256
JOB_AI_EMBEDDINGS_INTERVAL_MINUTES=120
JOB_AI_EMBEDDINGS_LIMIT=50

MEDIA_STORAGE_DIR=storage/uploads
MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_BUCKET=
MEDIA_REGION=auto
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

MEDIA_MODERATION_PROVIDER=DISABLED
MEDIA_MODERATION_DEFAULT_STATUS=APPROVED
MEDIA_MODERATION_REVIEW_THRESHOLD=0.65
MEDIA_MODERATION_REJECT_THRESHOLD=0.9
JOB_CLEANUP_INTERVAL_MINUTES=360
JOB_IDEMPOTENCY_RETENTION_HOURS=24
JOB_RUN_RETENTION_DAYS=14

PUBLIC_MEDIA_URL=http://localhost:4000/media

CORS_ORIGIN=http://localhost:3000,bookgram-ios-dev
